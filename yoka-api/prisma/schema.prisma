generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      Role     @default(Student)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userInfo UserInfo?

  // แก้ไข 1: เปลี่ยนชื่อ Relation ไม่ให้ซ้ำกัน
  createdCourses CourseYoga[]  @relation("CourseOwner") // คอร์สที่เป็นเจ้าของ/คนสร้าง
  teachingRounds CourseRound[] @relation("RoundTeacher") // รอบที่ต้องไปสอน (Instructor)
  bookings       Booking[]     @relation("StudentBookings") // การจองเรียน (Student)
}

model UserInfo {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatar       String?
  sex          Sex?     @default(NotSpecify)
  firstName    String?
  lastName     String?
  phone_number String?
  country      String?
  experience   String?
  facebook     String?
  instagram    String?
  twitter      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CourseYoga {
  id             String   @id @default(cuid())
  title          String
  description    String?  @db.Text
  price          Float
  discount_price Float?
  cover_image    String?
  images         String[] @default([])
  status         Status   @default(Draft)

  // แก้ไข 2: แมทช์ชื่อ Relation กับ User ("CourseOwner")
  teacherId String
  teacher   User   @relation("CourseOwner", fields: [teacherId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rounds CourseRound[]
}

model CourseRound {
  id String @id @default(cuid())

  courseId String
  course   CourseYoga @relation(fields: [courseId], references: [id], onDelete: Cascade)

  startDateTime DateTime
  endDateTime   DateTime

  max_online  Int @default(0)
  max_walk_in Int @default(0)

  // แก้ไข 3: แมทช์ชื่อ Relation กับ User ("RoundTeacher")
  teacherId String?
  teacher   User?   @relation("RoundTeacher", fields: [teacherId], references: [id], onDelete: SetNull)

  current_online  Int @default(0)
  current_walk_in Int @default(0)

  description String?

  status Status @default(Open)

  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Booking {
  id String @id @default(cuid())

  studentId String?
  student   User?   @relation("StudentBookings", fields: [studentId], references: [id])
  email     String?
  quantity  Int     @default(1)

  price Float

  // แก้ไข 4: เปลี่ยน onDelete เป็น Cascade
  // เพราะ roundId เป็น String (ห้าม Null) ดังนั้นถ้า Round หาย Booking นี้ควรหายไปด้วย
  // ถ้าอยากใช้ SetNull ตัว roundId ต้องเป็น String? (Optional)
  roundId String
  round   CourseRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  type      BookingType
  status    PaymentStatus @default(PENDING)
  paidAt    DateTime?
  paymentId String?

  description String?

  createdAt DateTime @default(now())
}

model Coupon {
  id          String  @id @default(uuid())
  code        String  @unique // รหัสคูปอง (เช่น WELCOME2024)
  description String?

  type  CouponType
  value Decimal // มูลค่า (ถ้าเป็น % คือ 10, ถ้าเป็นบาท คือ 100)

  // Constraints (เงื่อนไขการใช้)
  minSpend    Decimal? @default(0) // ยอดซื้อขั้นต่ำที่จะใช้ได้
  maxDiscount Decimal? // ลดสูงสุด (สำหรับแบบ %) ป้องกันการขาดทุนหนัก

  // Limits (จำกัดจำนวน)
  usageLimit  Int? // จำนวนสิทธิ์ทั้งหมดที่มี (ถ้า null คือไม่จำกัด)
  userLimit   Int? @default(1) // จำกัด 1 คนใช้ได้กี่ครั้ง
  currentUses Int  @default(0) // จำนวนที่ถูกใช้ไปแล้ว

  // Validity (ระยะเวลา)
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(true) // ปิด/เปิด คูปองฉุกเฉิน

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relation
  usages CouponUsage[]
}

model CouponUsage {
  id       String   @id @default(uuid())
  userId   String // ID ของ User ที่ใช้
  couponId String
  orderId  String? // ผูกกับ Order ID (ถ้ามี)
  discount Decimal // บันทึกไว้ว่าลดไปกี่บาทใน transaction นี้
  usedAt   DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id])

  // สร้าง Index เพื่อให้ค้นหาประวัติการใช้ของ user ได้เร็ว
  @@index([userId, couponId])
}

// Enum ประเภทคูปอง
enum CouponType {
  FIXED_AMOUNT // ลดเป็นจำนวนเงิน (เช่น ลด 100 บาท)
  PERCENTAGE // ลดเป็นเปอร์เซ็นต์ (เช่น ลด 10%)
}

enum Status {
  Draft
  Open
  Full
  Closed
}

enum BookingType {
  ONLINE
  WALK_IN
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELLED
}

enum Role {
  Instructor
  Admin
  Student
}

enum Sex {
  NotSpecify
  Other
  Male
  Female
}
